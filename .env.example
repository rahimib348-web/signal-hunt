# Optional: Kopiere diese Datei nach .env, um Werte zu überschreiben.
# Ohne .env verbindet sich die App mit unserem Supabase-Projekt "signal-hunt1"
# (eingetragen in src/lib/supabase.ts).
# Nur der öffentliche "Publishable key" gehört hierher, NIEMALS der Secret-Key.
# Beispiel für ein lokales Supabase (npx supabase start):
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Nur für Android-Builds außerhalb von Expo Go (Google Cloud → Maps SDK for Android).
GOOGLE_MAPS_ANDROID_API_KEY=

# Wird von "eas init" gesetzt.
EAS_PROJECT_ID=
